@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1>Welcome, @ViewBag.FirstName!</h1>
        <p class="text-muted">Welcome to your RaceDay participant dashboard.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4>Upload Profile Picture</h4>
            <form asp-controller="Uploads"
                  asp-action="UploadProfilePicture"
                  method="post"
                  enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="file" name="file" accept="image/png,image/jpeg,image/webp"
                       class="form-control mb-3" required />
                <button type="submit" class="btn btn-dark">Upload Picture</button>
            </form>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h4>Browse Events</h4>
                    <p>Explore available running, walking and cycling events.</p>
                    <a asp-controller="Events" asp-action="Index"
                       class="btn btn-dark">Browse Events</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h4>My Enrolments</h4>
                    <p>View the events you have registered for.</p>
                    <a asp-controller="Enrolments" asp-action="My"
                       class="btn btn-dark">My Enrolments</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h4>My Results</h4>
                    <p>Check your race finishing times and positions.</p>
                    <a asp-controller="Results" asp-action="My"
                       class="btn btn-dark">My Results</a>
                </div>
            </div>
        </div>

        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h4>Account</h4>
                    <p>Sign out of your RaceDay participant account.</p>
                    <a asp-controller="Auth" asp-action="Logout"
                       class="btn btn-danger">Logout</a>
                </div>
            </div>
        </div>
    </div>
</div>
