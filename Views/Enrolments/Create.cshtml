@model RaceDayMVC.Models.EnrolmentViewModel

<div class="container mt-5" style="max-width:500px">
    <h2>Enrol in Event</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger"></div>

        <input asp-for="EventID" type="hidden" />

        <div class="mb-3">
            <label asp-for="CategoryID">Category ID</label>
            <input asp-for="CategoryID" type="number"
                   class="form-control" min="1" />
            <span asp-validation-for="CategoryID"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-dark">
            Submit Enrolment
        </button>

        <a asp-controller="Events" asp-action="Index"
           class="btn btn-secondary">Cancel</a>
    </form>
</div>