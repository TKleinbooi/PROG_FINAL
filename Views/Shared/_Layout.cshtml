```cshtml
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>

    <style>
        body {
            background: #f4f6f9;
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 20px;
        }

        .text-center {
            text-align: center;
        }

        .text-muted {
            color: #666;
        }

        .mb-5 {
            margin-bottom: 40px;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .col-md-6 {
            flex: 1 1 40%;
            min-width: 260px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 10px #00000015;
            height: 100%;
            box-sizing: border-box;
        }

        .btn {
            display: block;
            padding: 12px;
            color: white;
            text-align: center;
            text-decoration: none;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
            box-sizing: border-box;
            font-size: 15px;
            font-weight: bold;
        }

        .btn-primary {
            background: #0d6efd;
        }

        .btn-success {
            background: #198754;
        }

        .btn-info {
            background: #0dcaf0;
            color: #111;
        }

        .btn-danger {
            background: #dc3545;
        }

        .btn-dark {
            background: #212529;
        }

        .navbar {
            background: #171717;
            padding: 18px;
        }

        .navbar-brand {
            color: white;
            font-weight: bold;
            text-decoration: none;
        }
    </style>
    <style>
        body {
            background-color: #f5f6fa;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background-color: #171717;
        }

        .navbar-brand {
            color: white;
            font-weight: bold;
        }

        .card {
            border: none;
            border-radius: 12px;
        }

        .btn {
            padding: 10px;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                RaceDay
            </a>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
```